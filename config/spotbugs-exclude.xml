<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- JMH 1.37 generates sampling stubs with an intentionally unused final startRndMask
       assignment. Do not edit generated harness code or suppress findings in benchmark sources. -->
  <Match>
    <Class name="~io\.github\.susongyan\.bobastraw\.benchmarks\.jmh_generated\..*"/>
    <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
  </Match>
  <!-- NioConnection read/write run only on the owning EventLoop. These fields use volatile
       for visibility to metrics readers, not for concurrent writers. TLS snapshot assignments
       also run on that same owner. Revisit these two exclusions if ownership ever changes. -->
  <Match>
    <Class name="io.github.susongyan.bobastraw.internal.NioConnection"/>
    <Method name="read"/>
    <Field name="socketReadOperations"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>
  <Match>
    <Class name="io.github.susongyan.bobastraw.internal.NioConnection"/>
    <Method name="write"/>
    <Field name="socketWriteOperations"/>
    <Bug pattern="VO_VOLATILE_INCREMENT"/>
  </Match>
</FindBugsFilter>
